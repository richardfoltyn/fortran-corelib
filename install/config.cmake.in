@PACKAGE_INIT@

set(fcore_VERSION "@PROJECT_VERSION@")
if(NOT CMAKE_Fortran_COMPILER_LOADED)
    set(fcore_FOUND FALSE)
    set(fcore_NOT_FOUND_MESSAGE "Enable the Fortran language before finding fcore.")
    return()
endif()

string(REGEX MATCH "^[0-9]+" _fcore_compiler_major "${CMAKE_Fortran_COMPILER_VERSION}")
if(NOT CMAKE_Fortran_COMPILER_ID STREQUAL "@CMAKE_Fortran_COMPILER_ID@"
        OR NOT _fcore_compiler_major STREQUAL "@FCORE_COMPILER_MAJOR@")
    set(fcore_FOUND FALSE)
    set(fcore_NOT_FOUND_MESSAGE
        "fcore was built with @CMAKE_Fortran_COMPILER_ID@ @CMAKE_Fortran_COMPILER_VERSION@; a matching compiler family and major version are required."
    )
    unset(_fcore_compiler_major)
    return()
endif()
unset(_fcore_compiler_major)

if(NOT TARGET fcore::fcore)
    include("${CMAKE_CURRENT_LIST_DIR}/fcoreTargets.cmake")
endif()

try_compile(_fcore_compiler_compatible
    SOURCES "${CMAKE_CURRENT_LIST_DIR}/compiler_test.f90"
    LINK_LIBRARIES fcore::fcore
    NO_CACHE
    LOG_DESCRIPTION "Check installed fcore Fortran modules and link compatibility"
    OUTPUT_VARIABLE _fcore_compiler_output
)
if(NOT _fcore_compiler_compatible)
    set(fcore_FOUND FALSE)
    set(fcore_NOT_FOUND_MESSAGE
        "The installed fcore failed its compiler compatibility check:\n${_fcore_compiler_output}"
    )
endif()
unset(_fcore_compiler_compatible)
unset(_fcore_compiler_output)

check_required_components(fcore)
